{
  "expo": {
    "name": "Harvest Tracker",
    "slug": "harvest-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harvesttracker.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to mark where you worked.",
        "NSLocationAlwaysUsageDescription": "We need your location to mark where you worked."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      },
      "package": "com.harvesttracker.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Harvest Tracker to use your location."
        }
      ]
    ]
  }
}
